# Schitzo Neural Router Environment Configuration

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Moonshot API Key (Required for model access)
# Get your API key from: https://platform.moonshot.cn/
MOONSHOT_API_KEY=your_moonshot_api_key_here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Langfuse Configuration (Optional - will be auto-generated if not provided)
# These keys are used for request tracing and observability
# You can generate them in the Langfuse UI after first startup
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Ollama Configuration (Optional - for local model classification)
# Default assumes Ollama is running on the host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Docker Configuration (Optional)
# Enable/disable telemetry for Langfuse
TELEMETRY_ENABLED=false

# Enable experimental features in Langfuse
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development mode settings (uncomment for development)
# DEBUG=true
# LOG_LEVEL=DEBUG

# Custom model endpoints (for development/testing)
# CUSTOM_MODEL_ENDPOINT=http://localhost:8080

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Production settings (uncomment for production deployment)
# ENVIRONMENT=production
# LOG_LEVEL=INFO
# CORS_ORIGINS=https://yourdomain.com
# DATABASE_URL=postgresql://user:pass@prod-db:5432/langfuse

# Security settings for production
# JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env files to version control
# 3. For production, use proper secret management
# 4. Restart services after changing environment variables